PORT=3001

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth: signerar shoppens egen inloggnings-cookie
JWT_SECRET=
NODE_ENV=development

# Google-inloggning
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_TIMEOUT_MS=10000

# Valutaadapter
CURRENCY_API_URL=https://api.frankfurter.dev/v1
CURRENCY_API_TIMEOUT_MS=5000
CURRENCY_CACHE_SECONDS=3600

# Leverantörens API (Labb 1)
SUPPLIER_API_URL=https://leverantor-api.vercel.app/v1
SUPPLIER_API_KEY=
SUPPLIER_API_TIMEOUT_MS=10000
SUPPLIER_BRANSCH=klader

# Sökfunktion ( Algolia). dashboard.algolia.com → Settings → API Keys
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX=reloved_products

# Betalning (Stripe, testläge). dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=http://localhost:5173
CHECKOUT_EXPIRES_MINUTES=30

# Frakt (Postnord, testläge). developer.postnord.com → My account → API keys
POSTNORD_API_KEY=
POSTNORD_API_URL=https://atapi2.postnord.com
POSTNORD_TIMEOUT_MS=5000
SHOP_POSTAL_CODE=11152
FREE_SHIPPING_FROM=500

# Cron för att bygga om sökindexet
CRON_SECRET=
