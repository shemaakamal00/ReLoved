PORT=3001

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Inloggning: signerar shoppens egen inloggningscookie. production gör cookien secure.
JWT_SECRET=
NODE_ENV=development

# Inloggning med Google. console.cloud.google.com → APIs & Services → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_TIMEOUT_MS=10000

# Inloggning för administratörer med GitHub. Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
GITHUB_TIMEOUT_MS=10000
ADMIN_GITHUB_LOGINS=

# Felrapporter. Fine-grained token med bara Issues: Read and write för shoppens repo
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=shemaakamal00/ReLoved

# Betalning (Stripe, testläge). dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=http://localhost:5173
CHECKOUT_EXPIRES_MINUTES=30

# E-post (Resend). Nyckeln behöver bara "Sending access".
# Utan egen domän: onboarding@resend.dev, som bara skickar till Resend-kontots adress.
# Med verifierad domän: ReLoved <order@re-loved.se>
RESEND_API_KEY=
EMAIL_FROM=ReLoved <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=5000

# Sökning (Algolia). dashboard.algolia.com → Settings → API Keys
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX=reloved_products

# Frakt (PostNord, testläge). atdeveloper.postnord.com → API keys
# SHOP_* är lagrets adress, som leveranstiden räknas från
POSTNORD_API_KEY=
POSTNORD_API_URL=https://atapi2.postnord.com
POSTNORD_TIMEOUT_MS=5000
POSTNORD_CUSTOMER_KEY=ReLoved
SHOP_STREET=Vasagatan 10
SHOP_POSTAL_CODE=11152
SHOP_CITY=Stockholm
SHOP_ORDER_CUTOFF=15:00
FREE_SHIPPING_FROM=500

# Valutakurser (Frankfurter, ingen nyckel behövs)
CURRENCY_API_URL=https://api.frankfurter.dev/v1
CURRENCY_API_TIMEOUT_MS=5000
CURRENCY_CACHE_SECONDS=3600

# Leverantörens produktkatalog
SUPPLIER_API_URL=https://leverantor-api.vercel.app/v1
SUPPLIER_API_KEY=
SUPPLIER_API_TIMEOUT_MS=10000
SUPPLIER_BRANSCH=klader

# Nattlig omindexering. Samma värde som secreten CRON_SECRET i GitHub Actions
CRON_SECRET=
